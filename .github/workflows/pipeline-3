name: Pipeline 3 - AI MDX Generator

on:
  repository_dispatch:
    types: [json-data-updated]
  workflow_dispatch:
    inputs:
      force:
        description: 'Force rebuild all MDX files (ignores .sync-manifest.json)'
        type: boolean
        default: false
      mock:
        description: 'Run in mock mode without calling Gemini API'
        type: boolean
        default: false

concurrency:
  group: pipeline-3-ai-mdx
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  generate-and-sync-mdx:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout central-docs-hub
        uses: actions/checkout@v6

      - name: Clone docusaurus-hub
        run: |
          git clone https://x-access-token:${{ secrets.DOCUSAURUS_REPO_PAT }}@github.com/harshh122/docusaurus-hub.git docusaurus-repo

      - name: Setup Python
        uses: actions/setup-python@v7
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Tesseract OCR & Python Dependencies
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq --no-install-recommends tesseract-ocr
          pip install -r requirements.txt

      - name: Run Offline Self-Test
        run: python3 scripts/compile_mdx.py --self-test

      - name: Compile JSON to MDX (AI)
        id: compile
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: |
          EXTRA_FLAGS=""
          if [ "${{ inputs.force }}" = "true" ]; then EXTRA_FLAGS="$EXTRA_FLAGS --force"; fi
          if [ "${{ inputs.mock }}" = "true" ]; then EXTRA_FLAGS="$EXTRA_FLAGS --mock"; fi

          python3 scripts/compile_mdx.py \
            --project-dir . \
            --docs-root ./docusaurus-repo/docs \
            --static-root ./docusaurus-repo/static \
            --manifest ./.sync-manifest.json \
            $EXTRA_FLAGS

      - name: Save .sync-manifest.json to central-docs-hub
        if: always()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          if [ -f .sync-manifest.json ]; then
            git add .sync-manifest.json
            if ! git diff --staged --quiet; then
              git commit -m "chore: update .sync-manifest.json"
              git pull --rebase origin main
              git push
            fi
          fi

      - name: Setup Node.js for Build Validation
        uses: actions/setup-node@v6
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: docusaurus-repo/package-lock.json

      - name: Validate Docusaurus Build
        working-directory: ./docusaurus-repo
        run: |
          npm ci
          npm run build

      - name: Push Validated MDX to docusaurus-hub
        id: push_mdx
        working-directory: ./docusaurus-repo
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add docs static
          if git diff --staged --quiet; then
            echo "No MDX or static asset changes to push."
            echo "changed=false" >> "$GITHUB_OUTPUT"
          else
            git commit -m "docs: sync AI-generated MDX and assets"
            git pull --rebase origin main
            git push
            echo "changed=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Trigger Pipeline 4 (Docusaurus Deploy)
        if: steps.push_mdx.outputs.changed == 'true'
        uses: peter-evans/repository-dispatch@v3
        with:
          token: ${{ secrets.DOCUSAURUS_REPO_PAT }}
          repository: harshh122/docusaurus-hub
          event-type: mdx-updated
          client-payload: '{"source": "central-docs-hub"}'
